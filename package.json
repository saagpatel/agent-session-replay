{
	"name": "agent-session-replay",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"description": "Local-first failure-forensics for Claude Code and Codex agent sessions",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
		"test:ui": "node scripts/ssr-ui-run.mjs",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.watchdog.json && tsc -p tsconfig.node.json",
		"check": "node scripts/check.mjs",
		"test:core": "node --test --experimental-strip-types \"src/core/**/*.test.ts\"",
		"test:export": "node --test --experimental-strip-types \"src/core/export/*.test.ts\"",
		"gen:replay-fixtures": "node --experimental-strip-types scripts/gen-replay-fixtures.ts",
		"test:branch": "node --test --experimental-strip-types \"src/core/diff/branch/*.test.ts\"",
		"run-diff:branches": "node --experimental-strip-types scripts/run-diff-branches.ts",
		"test:equiv": "node --test --experimental-strip-types \"src/core/diff/equiv/*.test.ts\"",
		"run-diff:equiv": "node --experimental-strip-types scripts/run-diff-equiv.ts",
		"afr:archives": "node --experimental-strip-types scripts/afr-archives.ts",
		"watchdog": "node --experimental-strip-types src/watchdog/main.ts",
		"parse:real": "node --experimental-strip-types scripts/parse-real.ts",
		"render:smoke": "node scripts/ssr-run.mjs",
		"tauri": "tauri"
	},
	"engines": {
		"node": ">=22.12"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.0.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
