{
	"name": "agent-session-replay",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Local-first failure-forensics for Claude Code and Codex agent sessions",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.watchdog.json",
		"test:core": "node --test --experimental-strip-types \"src/core/**/*.test.ts\"",
		"afr:archives": "node --experimental-strip-types scripts/afr-archives.ts",
		"watchdog": "node --experimental-strip-types src/watchdog/main.ts",
		"parse:real": "node --experimental-strip-types scripts/parse-real.ts",
		"render:smoke": "node scripts/ssr-run.mjs",
		"tauri": "tauri"
	},
	"engines": {
		"node": ">=22.6"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.3",
		"@types/node": "26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	}
}
