{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Agent Session Replay",
	"version": "0.1.0",
	"identifier": "dev.localfirst.agentsessionreplay",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Agent Session Replay",
				"width": 1440,
				"height": 940,
				"minWidth": 940,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "11.0"
		}
	}
}
